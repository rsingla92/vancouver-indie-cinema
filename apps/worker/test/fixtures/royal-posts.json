  "content": {
   "rendered": "\n<figure class=\"wp-block-image size-large\"><img decoding=\"async\" width=\"819\" height=\"1024\" data-src=\"https://theroyal.to/wp-content/uploads/2026/08/38exhibit-announcement-instagram-819x1024.png\" alt=\"\" class=\"wp-image-4172 lazyload\" data-srcset=\"https://theroyal.to/wp-content/uploads/2026/08/38exhibit-announcement-instagram-819x1024.png 819w, https://theroyal.to/wp-content/uploads/2026/08/38exhibit-announcement-instagram-240x300.png 240w, https://theroyal.to/wp-content/uploads/2026/08/38exhibit-announcement-instagram-768x960.png 768w, https://theroyal.to/wp-content/uploads/2026/08/38exhibit-announcement-instagram.png 1080w\" data-sizes=\"(max-width: 819px) 100vw, 819px\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMSIgaGVpZ2h0PSIxIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjwvc3ZnPg==\" style=\"--smush-placeholder-width: 819px; --smush-placeholder-aspect-ratio: 819/1024;\" /></figure>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>8Exhibit: Unmuted</strong></h3>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>38Exhibit: Unmuted</strong> is the third edition of the 38Exhibit series. This year, the event centres on the premiere of The Negotiation Space, a documentary series exploring the experiences, challenges, and creative journeys of Black artists and creatives in Toronto. Through intimate conversations and personal stories, the film highlights the realities of pursuing creative careers while navigating barriers to visibility, opportunity, and sustainability within the city&#8217;s creative landscape.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>About&nbsp;38</strong></p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://www.thirty8.xyz/about-3#anchors-lx5apqrh1\" data-type=\"link\" data-id=\"https://www.thirty8.xyz/about-3#anchors-lx5apqrh1\">38</a> is a Toronto-based creative hub dedicated to creating platforms and opportunities for emerging artists, musicians, dancers, filmmakers, poets, and other creatives. Through exhibitions and community-driven experiences, 38 aims to amplify underrepresented voices, foster meaningful connections, and showcase creative talent across Toronto.</p>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n\n\n\n<div class=\"wp-block-buttons is-content-justification-center is-layout-flex wp-container-core-buttons-is-layout-fe48e5de wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-white-color has-vivid-cyan-blue-background-color has-text-color has-background has-medium-font-size has-custom-font-size wp-element-button\" href=\"https://www.eventbrite.ca/e/38exhibit-unmuted-tickets-1992293171507?aff=erelexpmlt\">Get Tickets</a></div>\n</div>\n",
   "protected": false
  }
