# Server-only values. Never prefix secrets with NEXT_PUBLIC_.

# Postgres connection string. On Neon, use the pooled connection string from the
# project dashboard; it ends in ?sslmode=require. The site build reads from it and
# the worker writes to it. Leave empty to build the demo listings.
DATABASE_URL=

# TMDB API read access token (v4 bearer). Worker only.
TMDB_API_TOKEN=
