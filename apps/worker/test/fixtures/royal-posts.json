   "rendered": "\n<figure class=\"wp-block-image size-large\"><img decoding=\"async\" width=\"1024\" height=\"1024\" data-src=\"https://theroyal.to/wp-content/uploads/2026/07/ROBYN-SCHALL_Social-Square-1080x1080-1-1024x1024.jpg\" alt=\"\" class=\"wp-image-4062 lazyload\" data-srcset=\"https://theroyal.to/wp-content/uploads/2026/07/ROBYN-SCHALL_Social-Square-1080x1080-1-1024x1024.jpg 1024w, https://theroyal.to/wp-content/uploads/2026/07/ROBYN-SCHALL_Social-Square-1080x1080-1-300x300.jpg 300w, https://theroyal.to/wp-content/uploads/2026/07/ROBYN-SCHALL_Social-Square-1080x1080-1-150x150.jpg 150w, https://theroyal.to/wp-content/uploads/2026/07/ROBYN-SCHALL_Social-Square-1080x1080-1-768x768.jpg 768w, https://theroyal.to/wp-content/uploads/2026/07/ROBYN-SCHALL_Social-Square-1080x1080-1-712x712.jpg 712w, https://theroyal.to/wp-content/uploads/2026/07/ROBYN-SCHALL_Social-Square-1080x1080-1-75x75.jpg 75w, https://theroyal.to/wp-content/uploads/2026/07/ROBYN-SCHALL_Social-Square-1080x1080-1.jpg 1080w\" data-sizes=\"(max-width: 1024px) 100vw, 1024px\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMSIgaGVpZ2h0PSIxIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjwvc3ZnPg==\" style=\"--smush-placeholder-width: 1024px; --smush-placeholder-aspect-ratio: 1024/1024;\" /></figure>\n\n\n\n<h3 class=\"wp-block-heading\">The Just Married Comedy Tour</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Social media&#8217;s favourite funny lady, Robyn Schall, is going straight from the altar to the comedy club. Who needs a honeymoon when there are jokes and stories to tell? Fresh off her wedding, Robyn is hitting the road with her Just Married Comedy Tour, sharing hilarious behind-the-scenes moments, outrageous wedding stories, audience interaction, and all the chaos that comes with planning a wedding and starting married life. Whether you&#8217;ve followed Robyn for years or are discovering her for the first time, get ready for a one-of-a-kind night of stand-up, surprises, and laughs.&nbsp;</p>\n\n\n\n<div class=\"wp-block-buttons is-content-justification-center is-layout-flex wp-container-core-buttons-is-layout-fe48e5de wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-white-color has-vivid-cyan-blue-background-color has-text-color has-background has-medium-font-size has-custom-font-size wp-element-button\" href=\"https://admitone.com/events/robyn-schall-toronto-170331\">Buy Tickets</a></div>\n</div>\n",
