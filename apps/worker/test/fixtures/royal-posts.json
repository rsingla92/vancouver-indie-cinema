"wp-block-buttons is-content-justification-center is-layout-flex wp-container-core-buttons-is-layout-fe48e5de wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-white-color has-vivid-cyan-blue-background-color has-text-color has-background has-medium-font-size has-custom-font-size wp-element-button\" href=\"https://www.eventbrite.ca/e/persepolis-short-animation-program-presented-by-tisaf-rangarang-tickets-1996120491123\">Get Tickets</a></div>\n</div>\n",
