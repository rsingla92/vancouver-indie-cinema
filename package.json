{
  "name": "vancouver-indie-cinema",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@vic/web",
    "build": "npm run build --workspaces --if-present",
    "ingest": "npm run ingest --workspace=@vic/worker --",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
